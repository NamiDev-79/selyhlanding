# URL de la API de Selyh (backend NestJS). Solo la usa el servidor de Next: el navegador nunca habla directo con la API.
API_URL=http://localhost:3000
# URL pública de esta web (canónicas, sitemap, Open Graph). Debe coincidir con APP_URL del backend.
SITE_URL=http://localhost:5173

